# --- Twilio: the service that actually phones you (https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15125550100     # your Twilio number
MY_PHONE_NUMBER=+15125550199        # the phone that should ring

# --- Zoom (webhook mode) ---
ZOOM_WEBHOOK_SECRET_TOKEN=from_zoom_app_feature_page
ZOOM_PMI=1234567890                 # your Personal Meeting ID; blank = any meeting you host
IGNORE_PARTICIPANTS=you@utexas.edu,Your Name

# --- Behavior ---
COOLDOWN_SECONDS=300                # don't call more than once per 5 min per meeting
SEND_SMS=false
CALL_MESSAGE=Hey! {name} just joined your Zoom personal meeting room.

# --- Email fallback mode only (python -m zoomnotifier.email_watcher) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
IMAP_PASSWORD=gmail_app_password
POLL_SECONDS=20
ZOOM_EMAIL_SUBJECT_PATTERN=join
